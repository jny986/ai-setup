{
  "name": "ai-setup-docs",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "npm@11.20.0",
  "scripts": {
    "site:data": "node scripts/build-site-content.mjs",
    "site:dev": "node scripts/site.mjs dev",
    "site:build": "node scripts/site.mjs build",
    "site:preview": "vitepress preview site --host 127.0.0.1",
    "site:check": "node scripts/check-site.mjs",
    "site:test": "playwright test",
    "site:lint": "vp lint site/.vitepress/theme site/.vitepress/config.ts scripts/*.mjs tests/site playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "markdown-it": "14.3.3",
    "tailwindcss": "4.3.3",
    "vite-plus": "1.3.0",
    "vitepress": "2.0.0-alpha.20",
    "vue": "3.5.44"
  }
}
