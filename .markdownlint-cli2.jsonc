{
  // Skill docs are prose-heavy and mostly upstream-derived; formatting-only rules are off so lint catches real breakage (tables, etc.).
  "config": {
    "default": true,
    "MD012": false,
    "MD013": false,
    "MD022": false,
    "MD024": false,
    "MD025": false,
    "MD026": false,
    "MD029": false,
    "MD031": false,
    "MD032": false,
    "MD033": false,
    "MD034": false,
    "MD036": false,
    "MD040": false,
    "MD041": false,
    "MD049": false,
    "MD058": false,
    "MD060": false
  },
  "globs": ["**/*.md"],
  "ignores": ["original-skills/**", "node_modules/**"]
}
